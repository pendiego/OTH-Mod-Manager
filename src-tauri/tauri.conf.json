{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OTH Mod Manager",
  "version": "0.1.0",
  "identifier": "dev.pendiego.othmodmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "OTH Mod Manager",
        "width": 1280,
        "height": 800,
        "center": true,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "pendiego",
    "copyright": "Copyright (c) 2026 pendiego. MIT License.",
    "category": "Utility",
    "shortDescription": "Mod manager for over the hill",
    "longDescription": "Install and manage mods and liveries for over the hill. Installs MelonLoader/BepInEx for you and supports Nexus Mods one-click downloads.",
    "resources": ["licenses/*"],
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "nxm"
        ]
      }
    }
  }
}
